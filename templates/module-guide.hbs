<div class="dhui-guide">

  <section class="dhui-guide-section dhui-guide-section--warning">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-exclamation-triangle"></i>
      {{localize "DH_UNIDENTIFIED.GUIDE.requirementTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DH_UNIDENTIFIED.GUIDE.requirementBody"}}}
    </p>
    <div class="dhui-guide-steps">
      <p class="dhui-guide-steps__label">{{localize "DH_UNIDENTIFIED.GUIDE.assignLabel"}}</p>
      <ol class="dhui-guide-steps__list">
        <li>{{{localize "DH_UNIDENTIFIED.GUIDE.assignStep1"}}}</li>
        <li>{{{localize "DH_UNIDENTIFIED.GUIDE.assignStep2"}}}</li>
        <li>{{{localize "DH_UNIDENTIFIED.GUIDE.assignStep3"}}}</li>
      </ol>
    </div>
  </section>

  <section class="dhui-guide-section">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-eye-slash"></i>
      {{localize "DH_UNIDENTIFIED.GUIDE.hidingTitle"}}
