<div class="dhui-guide">

  <section class="dhui-guide-section dhui-guide-section--warning">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-exclamation-triangle"></i>
      {{localize "DHUI.Guide.RequirementTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DHUI.Guide.RequirementBody"}}}
    </p>
    <div class="dhui-guide-steps">
      <p class="dhui-guide-steps__label">{{localize "DHUI.Guide.AssignLabel"}}</p>
      <ol class="dhui-guide-steps__list">
        <li>{{{localize "DHUI.Guide.AssignStep1"}}}</li>
        <li>{{{localize "DHUI.Guide.AssignStep2"}}}</li>
        <li>{{{localize "DHUI.Guide.AssignStep3"}}}</li>
      </ol>
    </div>
  </section>

  <section class="dhui-guide-section">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-eye-slash"></i>
      {{localize "DHUI.Guide.HidingTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DHUI.Guide.HidingBody"}}}
    </p>
    <p class="dhui-guide-steps__note">
      {{localize "DHUI.Guide.HidingNote"}}
    </p>
  </section>

  <section class="dhui-guide-section">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-eye"></i>
      {{localize "DHUI.Guide.RevealingTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DHUI.Guide.RevealingBody"}}}
    </p>
  </section>

  <section class="dhui-guide-section">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-dice-d20"></i>
      {{localize "DHUI.Guide.RollTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DHUI.Guide.RollBody"}}}
    </p>
    <div class="dhui-guide-steps">
      <ol class="dhui-guide-steps__list">
        <li>{{localize "DHUI.Guide.RollStep1"}}</li>
        <li>{{localize "DHUI.Guide.RollStep2"}}</li>
        <li>{{{localize "DHUI.Guide.RollStep3"}}}</li>
        <li>{{{localize "DHUI.Guide.RollStep4"}}}</li>
      </ol>
      <p class="dhui-guide-steps__note">
        {{localize "DHUI.Guide.RollNote"}}
      </p>
    </div>
  </section>

  <section class="dhui-guide-section">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-users"></i>
      {{localize "DHUI.Guide.PartyTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DHUI.Guide.PartyBody"}}}
    </p>
  </section>

  <section class="dhui-guide-section">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-user-secret"></i>
      {{localize "DHUI.Guide.PrivacyTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DHUI.Guide.PrivacyBody"}}}
    </p>
  </section>

  <section class="dhui-guide-section">
    <h2 class="dhui-guide-section__title">
      <i class="fas fa-sliders-h"></i>
      {{localize "DHUI.Guide.DefaultsTitle"}}
    </h2>
    <p class="dhui-guide-section__body">
      {{{localize "DHUI.Guide.DefaultsBody"}}}
    </p>
  </section>

</div>
