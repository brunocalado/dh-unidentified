    <p class="dhui-guide-section__body">
      {{{localize "DH_UNIDENTIFIED.GUIDE.rollBody"}}}
    </p>
    <div class="dhui-guide-steps">
      <ol class="dhui-guide-steps__list">
        <li>{{{localize "DH_UNIDENTIFIED.GUIDE.rollStep1"}}}</li>
        <li>{{{localize "DH_UNIDENTIFIED.GUIDE.rollStep2"}}}</li>
        <li>{{{localize "DH_UNIDENTIFIED.GUIDE.rollStep3"}}}</li>
        <li>{{{localize "DH_UNIDENTIFIED.GUIDE.rollStep4"}}}</li>
