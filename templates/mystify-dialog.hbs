<div class="dhui-mystify-dialog">
  <p class="dhui-mystify-intro">
    {{{localize "DHUI.Mystify.Intro"}}}
  </p>

  <div class="dhui-field-group">
    <label class="dhui-label" for="dh-masked-name">{{localize "DHUI.Mystify.MaskedName"}}</label>
    <input
      class="dhui-input"
      type="text"
      id="dh-masked-name"
      name="maskedName"
      value="{{maskedName}}"
    />
  </div>

  <div class="dhui-field-group">
    <label class="dhui-label" for="dh-masked-img">{{localize "DHUI.Mystify.MaskedIcon"}}</label>
    <div class="dhui-file-row">
      <input
        class="dhui-input"
        type="text"
        id="dh-masked-img"
        name="maskedImg"
        value="{{maskedImg}}"
      />
      <button type="button" class="dhui-filepicker-btn" data-action="browse" title="{{localize 'DHUI.Common.BrowseFiles'}}">
        <i class="fas fa-folder-open"></i>
      </button>
    </div>
    <div class="dhui-icon-preview-wrap">
      <img
        class="dhui-icon-preview"
        src="{{maskedImg}}"
        alt="{{localize 'DHUI.Mystify.IconPreview'}}"
        draggable="false"
      />
    </div>
  </div>

  <div class="dhui-field-group">
    <label class="dhui-label" for="dh-masked-desc">{{localize "DHUI.Mystify.MaskedDescription"}}</label>
    <textarea
      class="dhui-input dhui-textarea"
      id="dh-masked-desc"
      name="maskedDesc"
    >{{maskedDesc}}</textarea>
  </div>
</div>
