<div class="dhui-ip-wrapper">
    <h1 class="dhui-ip-title">{{localize "DH_UNIDENTIFIED.PROMPT.label" name=maskedName}}</h1>
    <img src="{{maskedImg}}" class="dhui-ip-img" alt="{{maskedName}}">
    <p class="dhui-ip-details">
        {{#if difficulty}}
            {{localize "DH_UNIDENTIFIED.PROMPT.difficulty"}} <span class="dhui-ip-accent">{{difficulty}}</span><br>
        {{/if}}
        {{localize "DH_UNIDENTIFIED.PROMPT.check"}} <span class="dhui-ip-accent">{{traitLabel}}</span>
    </p>
    {{!-- Daggerheart's renderHandlebarsApplication hook binds the click handler
         on .duality-roll-button after this template is rendered, so the player's
         trusted click fires the system's own /dr path with SYSTEM in scope. --}}
    <div class="dhui-ip-roll-container">
        {{{enrichedRoll}}}
    </div>
</div>
